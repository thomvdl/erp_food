# Fichier .env unique pour tout le dossier erp_v2/ — lu par docker-compose.yml (interpolation
# des ${...} pour les ports/creds DB) ET injecté tel quel dans le conteneur api via env_file.
# Les valeurs fixées ailleurs (donc jamais à éditer ici) sont celles listées dans le bloc
# `environment:` du service api (DB_HOST, SESSION_DRIVER, etc.) — `environment:` prend toujours
# le dessus sur env_file.

# --- Identifiants admin seedés (AdminUserSeeder) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@erp.local
ADMIN_PASSWORD=password

# À true pour lancer DemoSeeder (données fictives : plan de salle, clients, personnel, catalogue
# produit) en plus des seeders de base. Laisser à false en prod.
DEMO=false

# --- Base de données ---
DB_DATABASE=erp_v2
DB_USERNAME=erp_v2_user
DB_PASSWORD=erp_v2_password
DB_ROOT_PASSWORD=root_password

# --- Ports exposés sur la machine hôte ---
# Plage 19xxx volontaire : le port 8000 est pris par mise-api, la plage 18xxx par ERP (v1),
# tous sur la même machine.
DB_PORT=19306
API_PORT=19001
APP_PORT=19002
VALIDATE_EVENT_PORT=19003
KITCHEN_DISPLAY_PORT=19005
REVERB_PORT_HOST=19004
ADMINER_PORT=19080

# --- Laravel (erp-api) ---
APP_NAME="ERP v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:19001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Reverb (broadcasting temps réel, kitchen display) ---
# À régénérer pour un vrai déploiement (php -r "echo bin2hex(random_bytes(16));"), les valeurs
# ci-dessous ne sont que des exemples de dev.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=erp_v2_kitchen
REVERB_APP_KEY=changeme_app_key
REVERB_APP_SECRET=changeme_app_secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
