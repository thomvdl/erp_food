# Gabarit pour le .env de production (docker-compose.prod.yml + Caddyfile), séparé du .env de
# dev — sur un vrai VPS, il n'y a qu'un seul de ces deux fichiers sur la machine (pas de conflit).
# Voir Readme.md, "Déploiement en production", pour le process complet.
#
# Usage : cp .env.production.example .env.production, remplir les valeurs ci-dessous (en
# particulier tout ce qui est marqué "À CHANGER"), puis sur le VPS : cp .env.production .env
# (docker-compose.prod.yml lit ./.env, comme le compose dev).

# --- Identifiants admin seedés (AdminUserSeeder) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGEME_mot_de_passe_admin_fort

# Toujours false en prod (DemoSeeder peuple des données fictives — plan de salle, clients,
# catalogue produit — utile seulement en dev/démo).
DEMO=false

# --- Base de données ---
DB_DATABASE=erp_v2
DB_USERNAME=erp_v2_user
DB_PASSWORD=CHANGEME_mot_de_passe_db_fort
DB_ROOT_PASSWORD=CHANGEME_mot_de_passe_db_root_fort

# --- Domaine (Caddyfile + docker-compose.prod.yml) ---
# Caddy sert api.$DOMAIN, app.$DOMAIN, kiosk.$DOMAIN, self-order.$DOMAIN, kitchen.$DOMAIN,
# validate-event.$DOMAIN, ws.$DOMAIN (Reverb). Les enregistrements DNS A de ces sous-domaines
# doivent pointer vers l'IP du VPS avant le premier démarrage (sinon Let's Encrypt échoue).
DOMAIN=CHANGEME_votredomaine.tld
ACME_EMAIL=CHANGEME_vous@votredomaine.tld

# --- Laravel (erp-api) ---
APP_NAME="ERP v2"
APP_ENV=production
# Générer avec : docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false

# APP_URL, SELF_ORDER_URL et CORS_ALLOWED_ORIGINS ne sont PAS à définir ici : ils sont calculés
# automatiquement par docker-compose.prod.yml à partir de DOMAIN (voir bloc `environment:` du
# service `api`) — toute valeur mise ici serait de toute façon écrasée.

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Reverb (broadcasting temps réel, kitchen display) ---
# REVERB_APP_KEY/SECRET : à régénérer, ne jamais réutiliser les valeurs de dev.
# ex. openssl rand -hex 16 / openssl rand -hex 20
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=erp_v2_kitchen
REVERB_APP_KEY=CHANGEME_reverb_app_key
REVERB_APP_SECRET=CHANGEME_reverb_app_secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- SMTP réel (les mails d'envoi de billets/tickets partent en synchrone, pas de queue) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGEME_smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_FROM_ADDRESS="CHANGEME@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
